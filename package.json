    "typecheck": "tsc --noEmit",
    "harness": "tsx harness/run.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffpyles/Kardashev-Zero.git"
  },
  "bugs": {
    "url": "https://github.com/jeffpyles/Kardashev-Zero/issues"
  },
  "homepage": "https://github.com/jeffpyles/Kardashev-Zero#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
